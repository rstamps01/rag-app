# ── Core ──────────────────────────────────────────────
PROJECT_NAME=RAG-APP-07
DEBUG=false

# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://rag:rag@postgres-07:5432/rag

# ── Qdrant Vector DB ─────────────────────────────────
QDRANT_URL=http://qdrant-07:6333
QDRANT_COLLECTION_NAME=rag

# ── Security / Auth ──────────────────────────────────
# REQUIRED: generate with `openssl rand -hex 32`
SECRET_KEY=CHANGE-ME-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256

# ── Models ───────────────────────────────────────────
LLM_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.2
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# ── Chunking ─────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
CHUNK_STRATEGY=sentence

# ── GPU ──────────────────────────────────────────────
USE_GPU=true
NVIDIA_VISIBLE_DEVICES=0

# ── CORS ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://frontend-07:3000,http://localhost:8000,http://backend-07:8000

# ── Upload ───────────────────────────────────────────
MAX_UPLOAD_SIZE=100MB
ALLOWED_EXTENSIONS=pdf,txt,docx,md

# ── Logging ──────────────────────────────────────────
LOG_FILE=/app/logs/rag-app.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=30
